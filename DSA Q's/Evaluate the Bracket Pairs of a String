from typing import List

class Solution:
    def evaluate(self, s: str, knowledge: List[List[str]]) -> str:
        # Convert knowledge into a dictionary for O(1) lookup
        mp = {key: value for key, value in knowledge}

        result = []
        i = 0

        while i < len(s):
            if s[i] == '(':
                # Find the closing bracket
                j = i + 1
                while s[j] != ')':
                    j += 1

                key = s[i + 1:j]

                # Replace with value, or "?" if key doesn't exist
                result.append(mp.get(key, "?"))

                i = j + 1
            else:
                result.append(s[i])
                i += 1

        return "".join(result)